<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>items</key>
	<array>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>footerText</key>
			<string>键盘在浮窗内的表现取決於被托管 App 与系统，本开关目前只存偏好、做不到改键盘行为，待真机验证。</string>
			<key>label</key>
			<string>浮窗键盘设置</string>
		</dict>
		<dict>
			<key>PostNotification</key>
			<string>com.guhailong.splitscreen.prefschanged</string>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>default</key>
			<true/>
			<key>defaults</key>
			<string>com.guhailong.splitscreen</string>
			<key>key</key>
			<string>keyboardAvoidEnabled</string>
			<key>label</key>
			<string>键盘弹出时浮窗自动上移</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>footerText</key>
			<string>探針：鍵盤通知由 App 行程發，可能到不了 SpringBoard；收到了窗才上移、收起回原位，收不到就不動。</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>footerText</key>
			<string>內彈出＝鍵盤出現在浮窗內、浮窗為它上移；外彈出＝鍵盤出現在浮窗外、浮窗不動。兩種都走鍵盤通知監聽，通知到不了 SpringBoard 就不動（探針）。</string>
			<key>label</key>
			<string>浮窗键盘弹出方式</string>
		</dict>
		<dict>
			<key>PostNotification</key>
			<string>com.guhailong.splitscreen.prefschanged</string>
			<key>cell</key>
			<string>PSLinkListCell</string>
			<key>default</key>
			<string>inner</string>
			<key>defaults</key>
			<string>com.guhailong.splitscreen</string>
			<key>key</key>
			<string>keyboardPopupMode</string>
			<key>label</key>
			<string>浮窗键盘弹出方式</string>
			<key>validTitles</key>
			<array>
				<string>浮窗内弹出</string>
				<string>外弹出</string>
			</array>
			<key>validValues</key>
			<array>
				<string>inner</string>
				<string>outer</string>
			</array>
		</dict>
		<dict>
			<key>PostNotification</key>
			<string>com.guhailong.splitscreen.prefschanged</string>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>default</key>
			<true/>
			<key>defaults</key>
			<string>com.guhailong.splitscreen</string>
			<key>key</key>
			<string>closeWindowOnExternalKeyboardHide</string>
			<key>label</key>
			<string>外置键盘收起同时关闭浮窗</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>footerText</key>
			<string>只在外弹出模式下生效；鍵盤收起時活動浮窗一起關掉。橫屏＋外彈出時，外置鍵盤可以拖動移位置（探針：SpringBoard 側能不能動到鍵盤視窗未證實）。</string>
		</dict>
	</array>
	<key>title</key>
	<string>浮窗键盘设置</string>
